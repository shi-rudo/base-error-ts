{
  "name": "@shirudo/base-error",
  "version": "9.0.1",
  "description": "A cross-environment base error class for TypeScript applications, designed for seamless use across Node.js, browsers, and edge runtimes.",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./public-error": "./src/public-error/index.ts",
    "./pino": "./src/pino/index.ts",
    "./sentry": "./src/sentry/index.ts"
  },
  "publish": {
    "include": ["src/**/*.ts", "README.md", "LICENSE", "CHANGELOG.md", "skills/**/*.md"],
    "exclude": ["src/__tests__/**"]
  },
  "keywords": [
    "typescript",
    "error",
    "base-error",
    "try-catch",
    "exception",
    "cross-platform",
    "cause",
    "stack-trace",
    "localization",
    "json",
    "problem-details",
    "rfc9457",
    "error-handling",
    "error-management",
    "error-propagation",
    "error-recovery",
    "error-logging",
    "deno",
    "cloudflare-workers",
    "edge-runtime"
  ]
}
